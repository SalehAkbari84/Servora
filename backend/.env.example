# ═══════════════════════════════════════════════════════════════════════════
#  PRODUCTION CHECKLIST (read before going live):
#   - APP_ENV=production  and  APP_DEBUG=false   (never leak stack traces)
#   - APP_KEY: run `php artisan key:generate`
#   - APP_URL / FRONTEND_URL: your real https domains
#   - DB_PASSWORD, ADMIN_PASSWORD: strong, unique — never ship the defaults
#   - After deploy: php artisan config:cache route:cache view:cache
# ═══════════════════════════════════════════════════════════════════════════

APP_NAME=Servora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran
APP_URL=http://localhost:8000

# Frontend origin(s) allowed by CORS. In production set this to your real
# frontend domain. FRONTEND_URLS (optional, comma-separated) adds extra ones.
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=

# ── Primary admin (created by AdminSeeder on setup) ──────────────────────
# The ONLY account that can reach the admin panel on a fresh install.
# CHANGE THE PASSWORD before selling / going to production.
ADMIN_USERNAME=admin
ADMIN_PHONE=09112801486
ADMIN_PASSWORD=ChangeMe@1234

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

# Keep this at 1 on Windows: multi-worker `php artisan serve` relies on fork()
# (Unix-only) and makes the dev server return intermittent 404/timeouts on
# Windows. Only affects `php artisan serve`, never production (nginx/php-fpm).
PHP_CLI_SERVER_WORKERS=1

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=servora
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local
FILAMENT_FILESYSTEM_DISK=public

QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=servora_

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@servora.ir"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── SMS Gateway (sms.ir) ─────────────────────────────────────────────────
# Get these from https://app.sms.ir/dashboard/Account/api-key
# Leave blank to disable SMS (set sms_otp_enabled=0 in admin settings to use
# dev mode where OTP codes are shown on screen instead of being sent).
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=
SMS_IR_MODE=production
SMS_IR_OTP_PARAM_NAME=OTP

# ── Web Push (VAPID) ─────────────────────────────────────────────────────
# Generate with:  npx web-push generate-vapid-keys
# Without these, push notifications (browser/mobile) are silently disabled —
# the in-app bell + SMS fallback still work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@servora.ir"
